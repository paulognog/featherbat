#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FeatherBat Project"
      VALUE "FileDescription", "FeatherBat Wireless Peripheral Battery Monitor"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "featherbat"
      VALUE "LegalCopyright", "Copyright (C) 2026 FeatherBat Contributors"
      VALUE "OriginalFilename", "featherbat.exe"
      VALUE "ProductName", "FeatherBat"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
